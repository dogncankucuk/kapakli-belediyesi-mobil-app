# MongoDB (bkz. docker-compose.yml -- `docker compose up -d` ile başlatılır)
MONGODB_URI=mongodb://localhost:27017/kapakli-bel-dev

# Admin panel oturum çerezi imzalama sırrı (rastgele, uzun bir string kullanın)
ADMIN_SESSION_SECRET=

# Admin panel girişinde TOTP (authenticator) kodu zorunlu mu? Boş/"true"
# bırakılırsa zorunludur (ÖNERİLEN, özellikle production'da). Sadece
# geliştirme kolaylığı için "false" yapılabilir - bu durumda e-posta+şifre
# yeterli olur.
ADMIN_REQUIRE_TOTP=true

# Seed script (npm run seed:admin) -- verilmezse dev için varsayılan e-posta ve
# rastgele üretilmiş bir şifre kullanılır
SEED_ADMIN_EMAIL=admin@kapakli.local
SEED_ADMIN_PASSWORD=

# Vatandaş (mobil) girişi icin JWT imzalama sırrı (rastgele, uzun bir string kullanın)
JWT_SECRET=

# "Google ile devam et" (mobil, kayıt ekranı) için Google Cloud Console'dan alınan
# OAuth 2.0 Client ID (Web application tipi). Boş bırakılırsa POST /auth/google
# 503 döner, uygulamanın geri kalanı etkilenmez.
GOOGLE_CLIENT_ID=

# Atık Noktaları içindeki "Yapay Zeka ile Atık Tanı" özelliği için
# huggingface.co/settings/tokens üzerinden alınan ÜCRETSİZ bir Hugging Face
# erişim anahtarı ("Inference Providers" izniyle, fineGrained token tipi).
# Boş bırakılırsa POST /atik-siniflandirma 503 döner, uygulamanın geri kalanı
# etkilenmez.
HUGGINGFACE_API_TOKEN=

# Tarayıcı tabanlı istemcilere (ör. üçüncü parti bir web sitesi) CORS izni
# verilecek origin'ler, virgülle ayrılmış (ör.
# "https://kapakli.bel.tr,https://admin.kapakli.bel.tr"). PRODUCTION'DA
# MUTLAKA AYARLANMALI. Boş bırakılırsa (yalnızca geliştirme için) tüm
# originlere izin verilir. Admin paneli bu sunucudan /admin altında servis
# edildiği için (aynı origin) bundan etkilenmez.
CORS_ORIGIN=
