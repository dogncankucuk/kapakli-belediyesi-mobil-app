# MongoDB (bkz. docker-compose.yml -- `docker compose up -d` ile başlatılır)
MONGODB_URI=mongodb://localhost:27017/kapakli-bel-dev

# Admin panel oturum çerezi imzalama sırrı (rastgele, uzun bir string kullanın)
ADMIN_SESSION_SECRET=

# Seed script (npm run seed:admin) -- verilmezse dev için varsayılan e-posta ve
# rastgele üretilmiş bir şifre kullanılır
SEED_ADMIN_EMAIL=admin@kapakli.local
SEED_ADMIN_PASSWORD=

# Vatandaş (mobil) girişi icin JWT imzalama sırrı (rastgele, uzun bir string kullanın)
JWT_SECRET=
